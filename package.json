{
  "name": "sunuecole",
  "version": "1.0.0",
  "private": true,
  "description": "SunuÉcole — Plateforme SaaS tout-en-un de gestion scolaire pour l'Afrique francophone (FCFA, Mobile Money, SMS, mode hors-ligne, bas débit).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "seed": "node server/src/db/seed.js",
    "seed:fresh": "node server/src/db/seed.js --fresh",
    "reset": "node server/src/db/seed.js --fresh",
    "backup": "node server/src/lib/backup.js",
    "test": "node --test server/tests/unit.test.js server/tests/smoke.test.js",
    "smoke": "node server/tests/smoke.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "serverless-http": "^4.0.0"
  }
}
